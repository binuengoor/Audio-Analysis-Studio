# Rendered by the nginx image's envsubst entrypoint into /etc/nginx/conf.d/default.conf.
# Only ${API_KEY} is substituted; nginx's own $variables are left untouched.
server {
    listen 80;
    server_name _;
    client_max_body_size 0; # Unlimited upload size for large lossless WAV/FLAC audio files

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Ensure service worker and register scripts are never aggressively cached
    location ~* (sw\.js|registerSW\.js)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://audio-analysis-backend:8000;
        proxy_http_version 1.1;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Attach the gateway API key server-side so it is never exposed to the browser
        # (an empty value means the header is not sent and the gateway runs in open mode)
        proxy_set_header X-API-Key "${API_KEY}";
    }

    location /files/ {
        proxy_pass http://audio-analysis-backend:8000;
        proxy_http_version 1.1;
        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Attach the gateway API key server-side so it is never exposed to the browser
        # (an empty value means the header is not sent and the gateway runs in open mode)
        proxy_set_header X-API-Key "${API_KEY}";
    }
}
