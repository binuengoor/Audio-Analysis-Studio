# Copy to .env (docker compose reads it automatically)

# Require this key on every API call. Leave empty ONLY on a trusted network.
# Generate one with: openssl rand -hex 24
API_KEY=

# Comma-separated browser origins allowed to call the gateway (default: any)
ALLOWED_ORIGINS=*

# Largest accepted upload, in MB
MAX_FILE_SIZE_MB=500

# Allow URL intake from private/LAN addresses (off by default - SSRF protection)
ALLOW_PRIVATE_URLS=false

# Ingest audio dropped into ./data/watch automatically (needs the celery-worker service)
WATCH_FOLDER=false
WATCH_INTERVAL_SECONDS=10
